{
  "version": 8,
  "name": "Kubus Light",
  "metadata": {
    "kubus:variant": "light",
    "kubus:basemap": "carto-vector",
    "kubus:derived-from": "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
    "kubus:notes": "art.kubus-owned MapLibre Style Spec v8 style built on CARTO's public vector basemap tiles. No API key is required or embedded. Dynamic Kubus layers (markers, clusters, routes, location) are appended on top of this style at runtime and therefore always draw above every basemap layer.",
    "kubus:semantic-zoom": {
      "z0-4": "Countries, national boundaries, capitals and major cities, water bodies, motorway spine.",
      "z4-7": "Generalized urban footprint (landuse residential/suburb), primary city labels, trunk and primary roads.",
      "z7-10": "Towns, parks, secondary roads, stronger urban footprint, generalized rail.",
      "z10-12": "Tertiary and local streets, county boundaries, village and suburb labels, detailed land use.",
      "z13-14": "Generalized building mass - the source ships one merged built-up polygon per tile at z13.",
      "z14+": "Individual building footprints with an offset top face that stays correct under pitch."
    },
    "kubus:source-limitations": "CARTO's carto.streets vector source (OpenMapTiles schema, maxzoom 14) carries no building geometry below z13: z12 tiles contain zero building features, z13 contains a single merged built-up mass per tile, and individual footprints only appear at z14. Cities are therefore represented at low and mid zoom by the generalized landuse urban footprint, never by synthesized building polygons.",
    "kubus:palette": {
      "background": "#F1F7FF",
      "urban": [
        "#DAE0E9",
        "#E4E8ED"
      ],
      "water": [
        "#C3D7E8",
        "#B7CFE4"
      ],
      "building": [
        "#D2D7DE",
        "#E9ECF0"
      ],
      "roads": [
        "#E3E5E8",
        "#CCCFD4",
        "#C2C5CB",
        "#B8BCC2",
        "#AEB2B9"
      ]
    }
  },
