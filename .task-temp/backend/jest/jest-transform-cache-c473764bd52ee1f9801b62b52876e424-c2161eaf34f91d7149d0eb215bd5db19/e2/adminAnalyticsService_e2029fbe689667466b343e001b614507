          FROM public.analytics_events
          WHERE event_category = 'app'
            AND ${propertyWhere}
            AND ${ingestWhere}
            AND ${eventIdWhere}
            AND ${sessionIdValueExpr} IS NOT NULL
            AND ${sessionIdValueExpr} IN (SELECT session_id FROM range_sessions)
            AND ${tsValueExpr} >= ($2::timestamptz - interval '${SESSION_FIRST_SEEN_LOOKBACK_DAYS} days')
            AND ${tsValueExpr} <= $3::timestamptz
          GROUP BY 1
        ),
        day_sessions AS (
          SELECT
            day,
