      const eventIdWhere = hasEventId ? `event_id IS NOT NULL` : `NULLIF(metadata->>'event_id', '') IS NOT NULL`;
      const userKeyExpr = hasActorUserId ? `NULLIF(actor_user_id::text, '')` : schema.columns.has('user_id') ? `user_id::text` : `NULLIF(metadata->>'actor_user_id', '')`;
      const dayExpr = `(date_trunc('day', (${tsBucketExpr} AT TIME ZONE 'UTC')) AT TIME ZONE 'UTC')`;
      const result = await query(`WITH range_events AS (
          SELECT
