  const cacheKey = `admin:analytics:app:activation-funnel::${normalizedProperty}::${ingestPath || 'all'}::${funnelKey}::${breakdownKey || 'none'}::${filterKey}::${range.from.toISOString()}::${range.to.toISOString()}`;
  return cache.wrap(cacheKey, async () => {
    const schema = await getAnalyticsEventsSchema();
