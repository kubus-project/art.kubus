    }
    const filterSql = filterClauses.join('\n          ');

    // Direct acquisition is the cohort whose attributed entry event landed on
    // `/register`. Merely having UTMs is insufficient: discovery-map campaigns
    // also carry UTMs through signup and must remain exclusively in the guest
    // funnel. The entry event owns cohort membership; its session join then
    // retains later activation stages even when an older client omitted UTM
    // fields from an individual downstream event.
    const directCohortSql = funnelKey === 'direct_acquisition' ? `WHERE EXISTS (
          SELECT 1
          FROM candidate_events entry
          WHERE entry.session_id = candidate.session_id
            AND entry.event_type = 'app_entry'
            AND NULLIF(entry.metadata->>'entry_route', '') = '/register'
            AND (
              COALESCE(NULLIF(entry.utm_campaign, ''), NULLIF(entry.metadata->>'utm_campaign', '')) IS NOT NULL
              OR COALESCE(NULLIF(entry.utm_source, ''), NULLIF(entry.metadata->>'utm_source', '')) IS NOT NULL
              OR COALESCE(NULLIF(entry.utm_medium, ''), NULLIF(entry.metadata->>'utm_medium', '')) IS NOT NULL
              OR COALESCE(NULLIF(entry.utm_content, ''), NULLIF(entry.metadata->>'utm_content', '')) IS NOT NULL
            )
        )` : '';

    // One scan feeds every output: per-stage counts, the per-session first-seen
    // timestamps used for durations, and the optional breakdown.
    const baseCte = `
      candidate_events AS (
        SELECT
          event_type,
          ${expr.sessionIdExpr} AS session_id,
          COALESCE(actor_user_id, user_id::text) AS actor_id,
          ${expr.tsExpr} AS event_ts,
          metadata,
          ${schema.columns.has('utm_campaign') ? 'utm_campaign' : "NULL::text AS utm_campaign"},
          ${schema.columns.has('utm_content') ? 'utm_content' : "NULL::text AS utm_content"},
          ${schema.columns.has('utm_source') ? 'utm_source' : "NULL::text AS utm_source"},
          ${schema.columns.has('utm_medium') ? 'utm_medium' : "NULL::text AS utm_medium"}
        FROM public.analytics_events
        WHERE event_category = 'app'
          AND ${expr.propertyExpr} = $1
          AND event_type = ANY($5::text[])
          AND ${expr.tsExpr} >= $2::timestamptz
          AND ${expr.tsExpr} <= $3::timestamptz
          AND ($4::text IS NULL OR ${expr.ingestPathExpr} = $4)
          AND ${expr.eventIdExpr} IS NOT NULL
          AND ${expr.sessionIdExpr} IS NOT NULL
          ${filterSql}
      ),
      base AS (
        SELECT candidate.*
        FROM candidate_events candidate
        ${directCohortSql}
      )`;
    const stageAggregates = stageList.map(stage => `
        COUNT(*) FILTER (WHERE event_type = '${stage}')::int AS ${stage}_events,
        COUNT(DISTINCT session_id) FILTER (WHERE event_type = '${stage}')::int AS ${stage}_sessions,
        COUNT(DISTINCT actor_id) FILTER (WHERE event_type = '${stage}' AND actor_id IS NOT NULL)::int AS ${stage}_users`).join(',');
    const totalsResult = await query(`WITH ${baseCte}
       SELECT ${stageAggregates}
       FROM base`, params);
    const totalsRow = totalsResult.rows[0] || {};

    // Median seconds between the major transitions, computed per session from
    // each stage's first occurrence. Sessions that never reached the later
    // stage are excluded rather than counted as zero.
    // Each transition is measured from the funnel definition, so the two
    // funnels report the durations that are meaningful to them rather than
    // one hard-coded set. Stages the funnel does not contain resolve to NULL
    // and drop out via the FILTER, exactly as an unreached stage does.
    const durationStages = Array.from(new Set(definition.durations.flatMap(([,, fromStage, toStage]) => [fromStage, toStage])));
    const firstsSelect = durationStages.map(stage => `MIN(event_ts) FILTER (WHERE event_type = '${stage}') AS first_${stage}`).join(',\n           ');
    const durationSelect = definition.durations.map(([, alias, fromStage, toStage]) => `
         percentile_cont(0.5) WITHIN GROUP (
           ORDER BY EXTRACT(EPOCH FROM (first_${toStage} - first_${fromStage}))
         ) FILTER (WHERE first_${toStage} IS NOT NULL AND first_${fromStage} IS NOT NULL
                     AND first_${toStage} >= first_${fromStage}) AS ${alias}`).join(',');
    const durationsResult = await query(`WITH ${baseCte},
       firsts AS (
         SELECT
           session_id,
           ${firstsSelect}
         FROM base
         GROUP BY session_id
       )
       SELECT ${durationSelect}
       FROM firsts`, params);
    const durationsRow = durationsResult.rows[0] || {};
    let breakdownRows = [];
    if (breakdownKey) {
      const dimensionExpr = ACTIVATION_BREAKDOWNS[breakdownKey];
      const breakdownEntries = definition.breakdownStages;
      const breakdownSelect = breakdownEntries.map(([, alias, stage]) => `COUNT(DISTINCT session_id) FILTER (WHERE event_type = '${stage}')::int AS ${alias}`).join(',\n           ');
      const rateBase = definition.breakdownRateBase;
      const rateBaseAlias = breakdownEntries.find(([key]) => key === rateBase)?.[1];
      const activatedAlias = breakdownEntries.find(([key]) => key === 'activatedSessions')?.[1];
      const breakdownResult = await query(`WITH ${baseCte},
         labelled AS (
           SELECT ${dimensionExpr} AS dimension, event_type, session_id
           FROM base
         )
         SELECT
           dimension,
           ${breakdownSelect}
         FROM labelled
         GROUP BY 1
         ORDER BY ${activatedAlias} DESC, ${rateBaseAlias} DESC, dimension ASC
         LIMIT ${ACTIVATION_BREAKDOWN_LIMIT}`, params);
      breakdownRows = breakdownResult.rows.map(r => {
        const row = {
          dimension: r.dimension || '(none)'
        };
        for (const [key, alias] of breakdownEntries) row[key] = Number(r[alias] || 0);
        row.activationRate = activationRate(row.activatedSessions, row[rateBase]);
        return row;
      });
    }
    const stages = [];
    let previousSessions = null;
    for (const stage of stageList) {
      const sessions = Number(totalsRow[`${stage}_sessions`] || 0);
      stages.push({
        stage,
        events: Number(totalsRow[`${stage}_events`] || 0),
        sessions,
        uniqueUsers: Number(totalsRow[`${stage}_users`] || 0),
        // Conversion from the immediately preceding stage, plus how many
        // sessions were lost there. Stages are not strictly nested — a session
        // can reach a later stage without emitting an earlier one — so the
        // ratio is clamped to 1 to stay consistent with `abandonedFromPrevious`,
        // which is floored at 0. `rawConversionFromPrevious` keeps the
        // unclamped value so an out-of-order funnel is still diagnosable.
        conversionFromPrevious: previousSessions === null ? null : Math.min(1, activationRate(sessions, previousSessions)),
        rawConversionFromPrevious: previousSessions === null ? null : activationRate(sessions, previousSessions),
        abandonedFromPrevious: previousSessions === null ? null : Math.max(0, previousSessions - sessions)
      });
      previousSessions = sessions;
    }
    const sessionsForStage = stage => stage ? stages.find(s => s.stage === stage)?.sessions ?? 0 : 0;
    const entrySessions = sessionsForStage(definition.entryStage);
    const registeredSessions = sessionsForStage(definition.registeredStage);
    const onboardedSessions = sessionsForStage(definition.onboardedStage);
    // "Activated" is a meaningful platform action, never a view or a login.
    const meaningfullyActivatedSessions = sessionsForStage(definition.activatedStage);
    // Preserved names for the original funnel's consumers: `activatedSessions`
    // has always meant "reached an account session" here, and
    // `completedSessions` "finished the pending action".
    const activatedSessions = funnelKey === DEFAULT_ACTIVATION_FUNNEL ? registeredSessions : meaningfullyActivatedSessions;
    const completedSessions = funnelKey === DEFAULT_ACTIVATION_FUNNEL ? meaningfullyActivatedSessions : sessionsForStage(definition.activatedStage);

    // `Number(null)` is 0, so guard explicitly: "no session reached this stage"
    // must report as null, not as an instant median.
    const asSeconds = value => {
      if (value === null || value === undefined || value === '') return null;
      const n = Number(value);
      return Number.isFinite(n) ? Math.round(n) : null;
    };
    const medianDurationsSeconds = {};
    for (const [key, alias] of definition.durations) {
      medianDurationsSeconds[key] = asSeconds(durationsRow[alias]);
    }
    return {
      property: normalizedProperty,
      from: range.from.toISOString(),
      to: range.to.toISOString(),
      funnel: funnelKey,
      availableFunnels: ACTIVATION_FUNNEL_KEYS,
      breakdown: breakdownKey,
      availableBreakdowns: ACTIVATION_BREAKDOWN_KEYS,
      // Echoed back so a dashboard can show what it is actually looking at,
      // and so an ignored/normalised filter is visible rather than silent.
      filters,
      stages,
      totals: {
        entrySessions,
        activatedSessions,
        completedSessions,
        activationRate: activationRate(activatedSessions, entrySessions),
        completionRate: activationRate(completedSessions, activatedSessions),
        // Explicit acquisition milestones. Registration alone is not
        // activation, so these are reported separately from the legacy pair
        // above rather than redefining it.
        registeredSessions,
        onboardedSessions,
        meaningfullyActivatedSessions,
        registrationRate: activationRate(registeredSessions, entrySessions),
        onboardingRate: activationRate(onboardedSessions, registeredSessions),
        activatedFromRegisteredRate: activationRate(meaningfullyActivatedSessions, registeredSessions),
        activatedFromEntryRate: activationRate(meaningfullyActivatedSessions, entrySessions)
      },
      medianDurationsSeconds,
      breakdownRows
    };
  }, {
    ttlSeconds: 60
  });
}
