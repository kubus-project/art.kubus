      const propertyWhere = hasProperty ? `(property = $1 OR (property IS NULL AND (metadata->>'property') = $1))` : `(metadata->>'property') = $1`;
      const sessionIdValueExpr = hasSessionId ? `NULLIF(session_id::text, '')` : `NULLIF(metadata->>'session_id', '')`;
