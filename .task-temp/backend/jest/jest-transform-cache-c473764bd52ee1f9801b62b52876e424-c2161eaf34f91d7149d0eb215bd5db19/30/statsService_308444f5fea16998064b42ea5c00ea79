async function resolveUserContext(walletAddress) {
  const requested = canonicalWallet(walletAddress);
  if (!requested) return {
    walletAddress: '',
    userId: null,
    profileId: null
  };
  const profileResult = await query(`SELECT p.id AS profile_id, p.wallet_address, p.user_id
     FROM profiles p
     WHERE ${walletMatchClause('p.wallet_address', 1)}
     ORDER BY (p.wallet_address = $1) DESC, p.updated_at DESC
     LIMIT 1`, [requested]);
  if (profileResult.rows.length === 0) {
    const userResult = await query(`SELECT id, wallet_address FROM users WHERE ${walletMatchClause('wallet_address', 1)} ORDER BY (wallet_address = $1) DESC LIMIT 1`, [requested]);
    const row = userResult.rows[0];
    return {
      walletAddress: canonicalWallet(row?.wallet_address || requested),
      userId: row?.id || null,
      profileId: null
    };
  }
  const profileRow = profileResult.rows[0];
  const normalizedWallet = canonicalWallet(profileRow.wallet_address || requested);
  let userId = profileRow.user_id || null;
  if (!userId) {
    const userResult = await query(`SELECT id FROM users WHERE ${walletMatchClause('wallet_address', 1)} ORDER BY (wallet_address = $1) DESC LIMIT 1`, [normalizedWallet]);
    userId = userResult.rows[0]?.id || null;
  }
  return {
    walletAddress: normalizedWallet,
    userId,
    profileId: profileRow.profile_id || null
  };
}
