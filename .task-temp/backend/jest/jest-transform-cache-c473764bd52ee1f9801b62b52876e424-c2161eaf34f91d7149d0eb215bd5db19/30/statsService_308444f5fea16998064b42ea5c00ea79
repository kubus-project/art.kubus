async function canAccessPrivateStats({
  entityType,
  entityId,
  req
}) {
  if (!req?.user) return false;
  const requesterWallet = resolveRequesterWallet(req);
  const requesterUserId = await resolveRequesterUserId(req);
  if (entityType === ENTITY_TYPES.platform) {
    const role = (req.user.role || '').toString().trim().toLowerCase();
    return role === 'admin';
  }
  if (entityType === ENTITY_TYPES.user) {
    return requesterWallet && walletsEqual(requesterWallet, entityId);
  }
  if (!requesterUserId && !requesterWallet) return false;
  if (entityType === ENTITY_TYPES.artwork) {
    if (!UUID_REGEX.test(entityId)) return false;
    const result = await query(`SELECT wallet_address, creator_id FROM artworks WHERE id = $1 LIMIT 1`, [entityId]);
    const row = result.rows[0];
    if (!row) return false;
    if (requesterUserId && row.creator_id && row.creator_id === requesterUserId) return true;
    return requesterWallet && walletsEqual(requesterWallet, row.wallet_address);
  }
  if (entityType === ENTITY_TYPES.collection) {
    if (!UUID_REGEX.test(entityId)) return false;
    const result = await query(`SELECT wallet_address, owner_id FROM collections WHERE id = $1 LIMIT 1`, [entityId]);
    const row = result.rows[0];
    if (!row) return false;
    if (requesterUserId && row.owner_id && row.owner_id === requesterUserId) return true;
    return requesterWallet && walletsEqual(requesterWallet, row.wallet_address);
  }
  if (entityType === ENTITY_TYPES.post) {
    if (!UUID_REGEX.test(entityId)) return false;
    const result = await query(`SELECT wallet_address, author_id FROM community_posts WHERE id = $1 LIMIT 1`, [entityId]);
    const row = result.rows[0];
    if (!row) return false;
    if (requesterUserId && row.author_id && row.author_id === requesterUserId) return true;
    return requesterWallet && walletsEqual(requesterWallet, row.wallet_address);
  }
  if (entityType === ENTITY_TYPES.event || entityType === ENTITY_TYPES.exhibition) {
    if (!UUID_REGEX.test(entityId)) return false;
    if (!requesterUserId) return false;
    const collabEntityType = entityType === ENTITY_TYPES.event ? 'events' : 'exhibitions';
    const result = await query(`SELECT role
       FROM collaboration_members
       WHERE entity_type = $1
         AND entity_id = $2
         AND member_user_id = $3
       ORDER BY created_at ASC
