{
  "name": "art-kubus-backend",
  "version": "0.7.3",
  "description": "art.kubus Backend API with IPFS/HTTP storage abstraction",
  "main": "src/server.js",
  "packageManager": "npm@11.7.0",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:ci": "jest --config jest.ci.config.cjs --coverage --runInBand --ci",
    "lint": "eslint \"src/**/*.js\" \"__tests__/**/*.js\" \"scripts/ci/**/*.js\" --max-warnings=0",
    "verify:toolchain": "node scripts/ci/verifyToolchain.js",
    "audit:ci": "node scripts/ci/auditDependencies.js",
    "audit:release": "node scripts/ci/auditDependencies.js --enforce-release",
    "schema:parity": "node scripts/ci/verifySchemaParity.js",
    "schema:bootstrap:ci": "node scripts/ci/verifySchemaBootstrap.js",
    "compose:validate": "node scripts/ci/verifyComposeConfig.js",
    "sync:version": "node scripts/sync_version.js",
    "sync:versions": "npm run sync:version",
    "migrate": "node src/db/migrate.js",
    "migrate:docker": "docker-compose run --rm backend npm run migrate",
    "seed": "node src/db/seed.js",
    "cache:prewarm": "node scripts/cachePrewarm.js",
    "admin:whitelist": "node scripts/adminWhitelist.js",
    "restore:public-snapshot": "node scripts/restorePublicSnapshot.js",
    "wallet-settlement:init-program-config": "node scripts/feeSplitterProgramConfig.js",
    "data:public-art:generate": "node scripts/open-public-art/cli.mjs",
    "data:public-art:validate": "node scripts/open-public-art/validateDataset.mjs",
    "data:public-art:seed": "node scripts/seedStreetArt.js --file data/open-public-art/regional-public-art.generated.json --require-image --verify-image-display",
    "data:public-art:dry-run": "node scripts/seedStreetArt.js --file data/open-public-art/regional-public-art.generated.json --dry-run --require-image",
    "data:public-art:coverage": "node scripts/open-public-art/cli.mjs --resume-from-coverage --only-incomplete --retry-incomplete-cities",
    "data:public-art:verify-images": "node scripts/open-public-art/validateDataset.mjs --verify-image-display",
    "data:public-art:verify-api": "node scripts/open-public-art/verifyPublicMarkersApi.mjs",
    "data:markers:check-subjects": "node scripts/diagnostics/check_marker_subject_integrity.mjs",
    "data:markers:check-subjects:strict": "node scripts/diagnostics/check_marker_subject_integrity.mjs --strict",
    "test:public-art": "node --test scripts/open-public-art/__tests__/exclusionPolicy.test.mjs scripts/open-public-art/__tests__/pipeline.test.mjs",
    "seo:preview": "node scripts/qa/seoPreviewServer.js",
    "migration:contract:editorial": "node scripts/ci/verifyEditorialSeedMigration.js"
  },
  "keywords": [
    "ar",
    "ipfs",
    "web3",
    "nft",
    "art"
