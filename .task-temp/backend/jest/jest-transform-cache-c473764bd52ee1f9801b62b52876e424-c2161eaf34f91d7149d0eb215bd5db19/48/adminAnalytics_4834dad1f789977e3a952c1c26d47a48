// Two preserved activation views:
//   guest_discovery: map/content -> protected action -> account -> restored action
//   direct_acquisition: attributed app entry -> registration -> onboarding
//     -> submitted contribution (registration alone is not activation).
// `breakdown` accepts one of the dimensions listed in `availableBreakdowns`;
// anything else is ignored rather than rejected, so a stale dashboard link
// still renders the totals.
router.get('/app/activation-funnel', asyncHandler(async (req, res) => {
  const {
    property,
    from,
    to,
    ingest,
    breakdown,
    funnel,
    utmCampaign,
    utmContent,
    utmSource,
    utmMedium
  } = req.query;
  const data = await adminAnalyticsService.getActivationFunnel({
    property,
    from,
    to,
    ingest,
    breakdown,
    // `funnel` selects guest_discovery (default) or direct_acquisition.
    funnel,
    // Campaign filters. Snake_case aliases are accepted because that is how
    // the values appear in the URLs operators paste from.
    utmCampaign: utmCampaign ?? req.query.campaign ?? req.query.utm_campaign,
    utmContent: utmContent ?? req.query.utm_content,
    utmSource: utmSource ?? req.query.utm_source,
    utmMedium: utmMedium ?? req.query.utm_medium
  });
  if ((req.query.format || '').toString().toLowerCase() === 'csv') {
    res.set('Content-Type', 'text/csv; charset=utf-8');
    // With a breakdown selected, export the per-dimension rows — that is the
    // campaign-by-campaign export. Without one, keep the stage export byte for
    // byte as it was, since existing consumers pin that header.
    if (data.breakdown && data.breakdownRows.length) {
      const columns = Object.keys(data.breakdownRows[0]).filter(k => k !== 'dimension');
      res.send(toCsv({
        header: [data.breakdown, ...columns.map(c => c.replace(/[A-Z]/g, m => `_${m.toLowerCase()}`))],
        rows: data.breakdownRows.map(r => [r.dimension, ...columns.map(c => r[c])])
      }));
      return;
    }
    res.send(toCsv({
      header: ['stage', 'events', 'sessions', 'unique_users', 'conversion_from_previous', 'abandoned_from_previous'],
      rows: data.stages.map(s => [s.stage, s.events, s.sessions, s.uniqueUsers, s.conversionFromPrevious === null ? '' : s.conversionFromPrevious, s.abandonedFromPrevious === null ? '' : s.abandonedFromPrevious])
    }));
    return;
  }
  res.json({
    success: true,
    data
  });
}));
