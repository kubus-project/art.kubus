// Diagnostics: isolate whether failures are UI->API (auth/CORS), API->DB (connectivity/schema),
// or query math. Never returns secrets (no raw env values).
router.get('/diag', asyncHandler(async (_req, res) => {
  const now = new Date();
  const safeEnv = {
    nodeEnv: String(process.env.NODE_ENV || 'development'),
    analyticsEventsEnabled: boolEnv(process.env.ANALYTICS_EVENTS_ENABLED, true),
    analyticsWebEnabled: boolEnv(process.env.ANALYTICS_WEB_ENABLED, true),
    databaseUrlConfigured: Boolean((process.env.DATABASE_URL || '').trim()),
    adminCorsOriginConfigured: Boolean((process.env.ADMIN_CORS_ORIGIN || '').trim()),
    corsOriginConfigured: Boolean((process.env.CORS_ORIGIN || '').trim()),
    adminSession: {
      cookieName: (process.env.ADMIN_SESSION_COOKIE_NAME || 'kubus_admin_sid').toString(),
      sameSite: (process.env.ADMIN_SESSION_SAMESITE || 'lax').toString(),
      domainConfigured: Boolean((process.env.ADMIN_SESSION_COOKIE_DOMAIN || '').trim()),
      store: (process.env.ADMIN_SESSION_STORE || 'memory').toString()
    },
    cache: cache.getMetrics()
  };
  const db = {
    ok: false,
    now: null,
    currentUser: null,
    database: null,
    version: null,
    error: null
  };
  const schema = {
    analyticsEvents: {
      exists: false
    },
    webAnalyticsEvents: {
      exists: false
    },
    legacyAnalyticsEvents: {
      exists: false
    }
  };
  const insertReadback = {
    attempted: false,
    ok: false,
    insertedId: null,
    readback: null,
    error: null
  };
  try {
    const ping = await query('SELECT NOW() AS now, current_user AS current_user, current_database() AS db, version() AS version');
    db.ok = true;
    db.now = ping.rows?.[0]?.now || null;
    db.currentUser = ping.rows?.[0]?.current_user || null;
    db.database = ping.rows?.[0]?.db || null;
    db.version = ping.rows?.[0]?.version || null;
    const reg = await query(`
      SELECT
        to_regclass('public.analytics_events') AS analytics_events,
        to_regclass('public.web_analytics_events') AS web_analytics_events,
        to_regclass('public.analytics_events') AS legacy_analytics_events
    `);
    schema.analyticsEvents.exists = Boolean(reg.rows?.[0]?.analytics_events);
    schema.webAnalyticsEvents.exists = Boolean(reg.rows?.[0]?.web_analytics_events);
    schema.legacyAnalyticsEvents.exists = Boolean(reg.rows?.[0]?.legacy_analytics_events);
    insertReadback.attempted = true;
    const id = randomUUID();
    const ts = now.toISOString();
    try {
      // Provide id explicitly so inserts work even if uuid-ossp isn't installed.
      const ins = await query(`INSERT INTO public.analytics_events (id, ts, property, event_type, event_category, metadata)
         VALUES ($1::uuid, $2::timestamptz, $3, $4, $5, $6::jsonb)
         RETURNING id, ts, property, event_type, event_category`, [id, ts, 'api.kubus.site', 'diag_insert', 'diag', JSON.stringify({
        diag: true
      })]);
      insertReadback.insertedId = ins.rows?.[0]?.id || id;
      const read = await query(`SELECT id, ts, property, event_type, event_category
         FROM public.analytics_events
         WHERE id = $1::uuid
         LIMIT 1`, [id]);
      insertReadback.readback = read.rows?.[0] || null;
      insertReadback.ok = Boolean(insertReadback.readback);
    } finally {
      // Best-effort cleanup (don't fail diag if delete fails).
      try {
        await query('DELETE FROM public.analytics_events WHERE id = $1::uuid', [id]);
      } catch (_) {}
    }
  } catch (e) {
    db.ok = false;
    db.error = e?.message || String(e);
    insertReadback.error = e?.message || String(e);
  }
  res.json({
    success: true,
    data: {
      env: safeEnv,
      db,
      schema,
      insertReadback,
      serverTime: now.toISOString()
    }
  });
}));
