<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

<uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
<uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
<uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
<uses-permission android:name="android.permission.CAMERA" />
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<uses-permission android:name="android.permission.USE_BIOMETRIC" />
<uses-permission android:name="android.permission.USE_FINGERPRINT" />
<uses-feature android:name="android.hardware.biometrics" android:required="false" />
<uses-feature android:name="android.hardware.fingerprint" android:required="false" />
<uses-feature android:name="android.hardware.camera.ar" android:required="true"/>

    <!--
      ACCESS_NETWORK_STATE backs connectivity_plus, which the Node transport
      resolver uses to notice a network change and re-evaluate which route to
      the paired Node is usable, rather than waiting for the current one to
      time out.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
    android:requestLegacyExternalStorage="true"
        android:label="art.kubus"
        android:name="${applicationName}"
        android:icon="@drawable/belilogo_crn"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic is required for the LAN rung: a kubus Node on a
          private address cannot hold a publicly trusted certificate, so it is
          reached over plain HTTP.

          It is deliberately broader than we want, and it cannot be narrowed
          here. A network security config matches domains, not address ranges —
          `<domain>192.168.0.0</domain>` matches that literal host and its
          subdomains, never the 192.168.x.x range — so scoping cleartext to
          private networks through the platform is not expressible, and a
          config that appears to do it would silently break every real LAN
          address instead.

          The restriction is therefore enforced in application code: a stored
          Node endpoint is only allowed to be plain HTTP when its host is a
          private-network address, and an operator-configured remote endpoint
          must be HTTPS. That check is the real control; this flag only stops
          the platform from vetoing it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="com.art.kubus"
              android:resource="@style/NormalTheme"
              android:value="623807687386-h0cbiqegcaint6s7gf4av9fvcvs1jmor.apps.googleusercontent.com"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- External wallet callback for Reown AppKit -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="artkubus" android:host="walletconnect"/>
            </intent-filter>

            <!-- Android App Links (canonical share URLs) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>

                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/marker/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/m/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/artwork/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/a/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/post/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/p/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/profile/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/user/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/u/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/collection/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/c/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/event/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/events/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/e/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/exhibition/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/exhibitions/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/x/" />
                <data android:scheme="https" android:host="app.kubus.site" android:pathPrefix="/n/" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- ARCore metadata -->
        <meta-data android:name="com.google.ar.core" android:value="required" tools:replace="android:value" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility?hl=en and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <package android:name="io.metamask" />
        <package android:name="app.phantom" />
        <package android:name="com.solflare.mobile" />

        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
       
        
    </queries>

</manifest>
